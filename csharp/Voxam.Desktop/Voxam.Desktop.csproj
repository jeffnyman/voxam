<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The desktop Voxam: the same core as the console, on Avalonia's
    glass. It publishes through NativeAOT like the console does, so a
    player installs nothing to run it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Voxam</AssemblyName>
    <RootNamespace>Voxam.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\voxam.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voxam.Core\Voxam.Core.csproj" />
  </ItemGroup>
</Project>
