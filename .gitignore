# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# The manual testing sheet: generated by tools/make-testing-sheet.py,
# which defaults to writing it here. It is a document about a corpus
# that is itself an optional submodule, so it is never the repository's
# to carry.
VOXAM-MANUAL-TESTS.md

# Local environment overrides
.env
.env.*
!.env.example

# Editor helpers
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Operating system metadata
**/.directory
**/.DS_Store
**/desktop.ini
**/Thumbs.db
